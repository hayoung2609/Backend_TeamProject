<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.mavenguard.mapper.KitMapper">

    <!-- ============================= -->
    <!-- 1️⃣ Kit 저장 -->
    <!-- ============================= -->
    <!-- useGeneratedKeys="true" : 생성된 kit_id를 KitVO.kitId에 주입 -->
    <insert id="insertKit"
            parameterType="org.example.mavenguard.vo.KitVO"
            useGeneratedKeys="true"
            keyProperty="kitId">
        INSERT INTO kits (user_id, title, description, is_public)
        VALUES (#{userId}, #{title}, #{description}, #{isPublic})
    </insert>

    <!-- ============================= -->
    <!-- 2️⃣ Kit 아이템 저장 -->
    <!-- ============================= -->
    <insert id="insertKitItem"
            parameterType="org.example.mavenguard.vo.KitItemVO">
        INSERT INTO kit_items (kit_id, group_id, artifact_id, version)
        VALUES (#{kitId}, #{groupId}, #{artifactId}, #{version})
    </insert>

    <!-- ============================= -->
    <!-- 3️⃣ 내 Kit 목록 조회 -->
    <!-- ============================= -->
    <select id="selectKitsByUserId"
            resultType="org.example.mavenguard.vo.KitVO">
        SELECT
            kit_id   AS kitId,
            user_id  AS userId,
            title,
            description,
            is_public AS isPublic,
            created_at AS createdAt
        FROM kits
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <!-- ============================= -->
    <!-- 4️⃣ 특정 Kit의 아이템 조회 -->
    <!-- ============================= -->
    <select id="selectItemsByKitId"
            resultType="org.example.mavenguard.vo.KitItemVO">
        SELECT
            item_id     AS itemId,
            kit_id      AS kitId,
            group_id    AS groupId,
            artifact_id AS artifactId,
            version
        FROM kit_items
        WHERE kit_id = #{kitId}
        ORDER BY item_id ASC
    </select>

    <!-- ============================= -->
    <!-- 5️⃣ ⭐ 내 Kit인지 검증 (추가됨) -->
    <!-- ============================= -->
    <select id="countMyKit" resultType="int">
        SELECT COUNT(*)
        FROM kits
        WHERE kit_id = #{kitId}
          AND user_id = #{userId}
    </select>

</mapper>
