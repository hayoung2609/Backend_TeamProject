<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.mavenguard.mapper.KitMapper">

    <!-- 1. Kit 저장 -->
    <!-- useGeneratedKeys="true" keyProperty="kitId": DB가 만든 PK값을 KitVO에 넣어줌 -->
    <insert id="insertKit" parameterType="org.example.mavenguard.vo.KitVO"
            useGeneratedKeys="true" keyProperty="kitId">
        INSERT INTO kits (user_id, title, description, is_public)
        VALUES (#{userId}, #{title}, #{description}, #{isPublic})
    </insert>

    <!-- 2. 아이템 저장 -->
    <insert id="insertKitItem" parameterType="org.example.mavenguard.vo.KitItemVO">
        INSERT INTO kit_items (kit_id, group_id, artifact_id, version)
        VALUES (#{kitId}, #{groupId}, #{artifactId}, #{version})
    </insert>

    <!-- 3. 목록 조회 -->
    <select id="selectKitsByUserId" resultType="org.example.mavenguard.vo.KitVO">
        SELECT * FROM kits WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <!-- 4. 아이템 조회 -->
    <select id="selectItemsByKitId" resultType="org.example.mavenguard.vo.KitItemVO">
        SELECT * FROM kit_items WHERE kit_id = #{kitId}
    </select>

</mapper>